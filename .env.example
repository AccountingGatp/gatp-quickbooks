# ---------- Login (one shared GATP login; each person types their own name) ----------
APP_LOGIN_EMAIL=accounting@gatpsolutions.com
APP_PASSWORD=choose-a-strong-password
# Long random text, 32+ characters. Signs the login cookie.
SESSION_SECRET=
# Long random text, 32+ characters. Encrypts QuickBooks tokens stored in MongoDB.
TOKEN_ENCRYPTION_KEY=

# ---------- MongoDB (Atlas connection string) ----------
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gatp_ledger

# ---------- Intuit app (developer.intuit.com -> your app -> Keys & credentials) ----------
QB_CLIENT_ID=
QB_CLIENT_SECRET=
# sandbox = test companies, production = real client companies
QB_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI in the Intuit app
QB_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# ---------- Optional ----------
# QB_MOCK=1  -> fake QuickBooks companies with sample data, for trying every screen without Intuit keys
